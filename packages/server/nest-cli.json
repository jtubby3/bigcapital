{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "i18n/**/*"
      },
      {
        "include": "database/**/*",
        "exclude": "**/*.ts"
      },
      {
        "include": "modules/PackingSlips/native/*.swift"
      },
      {
        "include": "modules/PackingSlips/native/packing_scan_linux.py"
      }
    ]
  },
  "projects": {
    "cli": {
      "type": "application",
      "root": "src",
      "entryFile": "cli",
      "sourceRoot": "src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json"
      }
    }
  }
}
